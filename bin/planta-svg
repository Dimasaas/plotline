#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "optparse"
require "planta_svg"

opcoes = {}
parser = OptionParser.new do |o|
  o.banner = "Uso: planta-svg [opções] entrada.geojson > saida.svg   (ou '-' para ler da entrada padrão)"
  o.on("--largura N", Integer, "largura do SVG em unidades (padrão 1600)") { |n| opcoes[:largura] = n }
  o.on("-v", "--version", "mostra a versão") do
    puts PlantaSvg::VERSION
    exit
  end
  o.on("-h", "--help", "ajuda") do
    puts o
    exit
  end
end

begin
  parser.parse!
  arquivo = ARGV.shift
  if arquivo.nil?
    warn parser
    exit 2
  end
  texto = arquivo == "-" ? $stdin.read : File.read(arquivo, encoding: "UTF-8")
  $stdout.write PlantaSvg.converter(texto, **opcoes)
rescue PlantaSvg::Erro, OptionParser::ParseError, SystemCallError => e
  warn "planta-svg: #{e.message}"
  exit 1
end
