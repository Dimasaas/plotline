#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "optparse"
require "plotline"

opcoes = {}
parser = OptionParser.new do |o|
  o.banner = "Uso: plotline [opções] entrada.geojson > saida.svg   (ou '-' para ler da entrada padrão)"
  o.on("--largura N", Integer, "largura do SVG em unidades (padrão 1600)") { |n| opcoes[:largura] = n }
  o.on("--titulo TEXTO", "título no topo da planta") { |t| opcoes[:titulo] = t }
  o.on("--giro GRAUS", Float, "força o giro (anti-horário) em vez de escolher o melhor") { |g| opcoes[:giro] = g }
  o.on("--sem-rotacao", "não gira a planta (mantém o norte para cima)") { opcoes[:giro] = 0.0 }
  o.on("--sem-rotulos", "não escreve números de lote nem de quadra") { opcoes[:rotulos] = false }
  o.on("-v", "--version", "mostra a versão") do
    puts Plotline::VERSION
    exit
  end
  o.on("-h", "--help", "ajuda") do
    puts o
    exit
  end
end

begin
  parser.parse!
  arquivo = ARGV.shift
  if arquivo.nil?
    warn parser
    exit 2
  end
  texto = arquivo == "-" ? $stdin.read : File.read(arquivo, encoding: "UTF-8")
  $stdout.write Plotline.converter(texto, **opcoes)
rescue Plotline::Erro, OptionParser::ParseError, SystemCallError => e
  warn "plotline: #{e.message}"
  exit 1
end
